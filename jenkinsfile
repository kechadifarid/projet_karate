pipeline {
    parameters {
        booleanParam(name: 'UsingTag', defaultValue: true, description: 'lancer avec tag')
        choice(name: 'tags', choices: ['CreationEmp', 'ajoutEVent', 'CreationEmpToken'], description: 'cibler les test qu on veut executer ')
    }
    agent {
        docker {
            image 'maven:ibmjava'
            args '-u root --entrypoint='
        }
    }
    stages {
        stage("lancer les tetst ") {
            steps {
                sh 'mvn clean compile'
                script {
                    if(!params.UsingTag)
                    {
                         sh 'mvn test'

                    }
                    else {
                        sh "mvn test -Dkarate.options=\"--tags @${params.tags}\""

                    }
                }
            }
        }
    }
}